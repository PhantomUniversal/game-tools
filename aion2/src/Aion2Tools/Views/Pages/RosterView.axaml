<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aion2Tools.ViewModels"
             xmlns:models="using:Aion2Tools.Models"
             xmlns:views="using:Aion2Tools.Views"
             x:Class="Aion2Tools.Views.Pages.RosterView"
             x:DataType="vm:RosterViewModel">

    <UserControl.Styles>
        <!-- The box that creates a group: a plain solid outline with a plus. -->
        <Style Selector="Button.addBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="Button.addBox:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <!-- A character row: the main sits on a tinted band, alts on the sunken area around them. -->
        <Style Selector="Border.row">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="Border.row.main">
            <Setter Property="Background" Value="{StaticResource MainRowBrush}" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource ChipBrush}" />
        </Style>
        <Style Selector="Border.chip.main">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Border.chip.main > TextBlock">
            <Setter Property="Foreground" Value="#0B0D14" />
        </Style>
        <Style Selector="TextBlock.columnHeader">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <!-- One character row; the main has no delete button, it goes with its group. -->
        <DataTemplate DataType="vm:CharacterRowViewModel">
            <Border Classes="row" Classes.main="{Binding Character.IsMain}">
                <Grid ColumnDefinitions="44,64,180,170,120,120,40">
                    <CheckBox Grid.Column="0" IsChecked="{Binding Character.IsSelected}" />
                    <Border Grid.Column="1" Classes="chip" Classes.main="{Binding Character.IsMain}">
                        <TextBlock Text="{Binding KindText}" FontSize="12" FontWeight="Bold" />
                    </Border>
                    <TextBox Grid.Column="2" Text="{Binding Character.Name}" PlaceholderText="캐릭터 이름" Margin="0,0,6,0" />
                    <ComboBox Grid.Column="3" HorizontalAlignment="Stretch" Margin="0,0,6,0"
                              ItemsSource="{Binding $parent[UserControl].((vm:RosterViewModel)DataContext).Classes}"
                              SelectedValueBinding="{Binding Id, DataType=models:ClassRecord}"
                              SelectedValue="{Binding Character.ClassId, Converter={x:Static views:IgnoreNullConverter.Instance}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="models:ClassRecord">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Grid.Column="4" Text="{Binding CombatPowerText}" HorizontalContentAlignment="Right" Margin="0,0,6,0" />
                    <TextBox Grid.Column="5" Text="{Binding ItemLevelText}" HorizontalContentAlignment="Right" Margin="0,0,6,0" />
                    <Button Grid.Column="6" Content="✕" IsVisible="{Binding !Character.IsMain}"
                            Command="{Binding $parent[UserControl].((vm:RosterViewModel)DataContext).RemoveAltCommand}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="캐릭터 명단" Classes="h1" Margin="0,0,0,12" />

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <Button Content="전체 참가" Command="{Binding SelectAllCommand}" Margin="0,0,8,6" />
            <Button Content="전체 해제" Command="{Binding SelectNoneCommand}" Margin="0,0,8,6" />
            <Button Content="비우기" Command="{Binding ClearCommand}" Margin="0,0,8,6" />
        </WrapPanel>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Classes="muted" Margin="0,0,0,8" />

        <ScrollViewer Grid.Row="3">
            <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Left">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="14" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PlayerGroupViewModel">
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10"
                                    Background="{StaticResource PanelBrush}" Padding="12">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Title}" Classes="h2" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        <Button Grid.Column="1" Content="그룹 삭제"
                                                Command="{Binding $parent[UserControl].((vm:RosterViewModel)DataContext).RemoveGroupCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>

                                    <StackPanel Spacing="4" Margin="0,4,0,0">
                                        <Grid ColumnDefinitions="44,64,180,170,120,120,40" Margin="8,0">
                                            <TextBlock Grid.Column="0" Text="참가" Classes="columnHeader" />
                                            <TextBlock Grid.Column="1" Text="구분" Classes="columnHeader" />
                                            <TextBlock Grid.Column="2" Text="캐릭터" Classes="columnHeader" />
                                            <TextBlock Grid.Column="3" Text="클래스" Classes="columnHeader" />
                                            <TextBlock Grid.Column="4" Text="전투력" Classes="columnHeader" />
                                            <TextBlock Grid.Column="5" Text="아이템 레벨" Classes="columnHeader" />
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource LineBrush}" />
                                    </StackPanel>

                                    <ContentControl Content="{Binding Main}" />

                                    <Border Background="{StaticResource SunkenBrush}" CornerRadius="8" Padding="0,6">
                                        <StackPanel Spacing="2">
                                            <ItemsControl ItemsSource="{Binding Alts}" />
                                            <Button Content="+  부캐 추가" HorizontalAlignment="Left" Margin="8,2,0,0"
                                                    Command="{Binding $parent[UserControl].((vm:RosterViewModel)DataContext).AddAltCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Classes="addBox" Content="{Binding AddGroupText}" Command="{Binding AddGroupCommand}"
                        IsVisible="{Binding CanAddGroup}" />
            </StackPanel>
        </ScrollViewer>

        <Expander Grid.Row="4" Header="표 / CSV 붙여넣기" Margin="0,10,0,0" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="한 줄에 한 캐릭터: 번호(1~10), 캐릭터, 클래스(이름 또는 id), 전투력, 아이템 레벨, 본캐(Y/N). 전투력 · 아이템 레벨은 - 로 비워 둘 수 있고, 쉼표나 탭(스프레드시트 복사) 모두 됩니다." />
                <TextBox Text="{Binding ImportText}" AcceptsReturn="True" Height="120"
                         PlaceholderText="1, 철벽, 수호성, 36210, -, Y" />
                <Button Content="가져오기" Classes="accent" Command="{Binding ImportCommand}" />
            </StackPanel>
        </Expander>
    </Grid>
</UserControl>
