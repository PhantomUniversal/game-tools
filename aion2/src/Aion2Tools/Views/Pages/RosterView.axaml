<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aion2Tools.ViewModels"
             xmlns:models="using:Aion2Tools.Models"
             xmlns:views="using:Aion2Tools.Views"
             x:Class="Aion2Tools.Views.Pages.RosterView"
             x:DataType="vm:RosterViewModel">

    <UserControl.Styles>
        <!-- The fold header is the whole hit target, as in a properties panel. -->
        <Style Selector="Border.foldHeader.toggle">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.foldHeader.toggle:pointerover">
            <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
        </Style>
        <Style Selector="Border.foldHeader.collapsed">
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Path.chevron">
            <Setter Property="Stroke" Value="{StaticResource TextDimBrush}" />
            <Setter Property="StrokeThickness" Value="3" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <!-- One character as a foldout: the header (chevron, kind, name) toggles the form under it. -->
        <DataTemplate DataType="vm:CharacterRowViewModel">
            <Border Classes="foldBox">
                <StackPanel>
                    <Border Classes="foldHeader toggle" Classes.collapsed="{Binding !IsExpanded}" Tapped="OnFoldTapped">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                            <Viewbox Grid.Column="0" Width="11" Height="11" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="chevron" Data="M9,5 l7,7 l-7,7" IsVisible="{Binding !IsExpanded}" />
                                    <Path Classes="chevron" Data="M5,9 l7,7 l7,-7" IsVisible="{Binding IsExpanded}" />
                                </Canvas>
                            </Viewbox>
                            <Border Grid.Column="1" Classes="badge" Classes.accent="{Binding Character.IsMain}">
                                <TextBlock Text="{Binding KindText}" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding DisplayName}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="3" Classes="rowIcon danger" Width="20" Height="20"
                                    IsVisible="{Binding !Character.IsMain}" Tapped="OnRemoveAltTapped">
                                <Viewbox Width="10" Height="10">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M6,6 L18,18 M18,6 L6,18" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Classes="foldBody" IsVisible="{Binding IsExpanded}">
                        <StackPanel Spacing="12">
                            <StackPanel>
                                <TextBlock Text="캐릭터 이름" Classes="fieldLabel" />
                                <TextBox Text="{Binding Character.Name}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="클래스" Classes="fieldLabel" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding $parent[UserControl].((vm:RosterViewModel)DataContext).Classes}"
                                          SelectedValueBinding="{Binding Id, DataType=models:ClassRecord}"
                                          SelectedValue="{Binding Character.ClassId, Converter={x:Static views:IgnoreNullConverter.Instance}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="models:ClassRecord">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Image Width="24" Height="24"
                                                       Source="{Binding Id, Converter={x:Static views:ClassIconConverter.Instance}}" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,10,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="전투력" Classes="fieldLabel" />
                                    <TextBox Text="{Binding CombatPowerText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="아이템 레벨" Classes="fieldLabel" />
                                    <TextBox Text="{Binding ItemLevelText}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid ColumnDefinitions="*,Auto">

        <!-- Left: the group cards. -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="24,20,24,0">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="캐릭터 명단" Classes="pageTitle" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding CountText}" Classes="meta" />
                        <TextBlock Text="{Binding StatusText}" Classes="meta" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="명단 비우기" Classes="danger" Command="{Binding ClearCommand}" />
                    <Button Content="불러오기" Click="OnImportClick" />
                    <Button Content="내보내기" Click="OnExportClick" />
                    <Button Content="+  새 그룹" Classes="accent" Command="{Binding AddGroupCommand}"
                            IsEnabled="{Binding CanAddGroup}" />
                </StackPanel>
            </Grid>

            <!-- Columns fill the width (set in code-behind); every tile in a row stretches to that row's height. -->
            <ScrollViewer Grid.Row="1" SizeChanged="OnCardWallSizeChanged">
                <ItemsControl x:Name="CardWall" ItemsSource="{Binding Tiles}" Margin="0,0,-14,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>
                        <!-- A group card: the main as the header, the alts listed under it. -->
                        <DataTemplate DataType="vm:PlayerGroupViewModel">
                            <Border Classes="card clickable" Classes.selected="{Binding IsSelected}"
                                    Margin="0,0,14,14" Tapped="OnGroupTapped">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Image Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0"
                                               Source="{Binding Main.Character.ClassId, Converter={x:Static views:ClassIconConverter.Instance}}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Main.DisplayName}" Classes="cardTitle" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Main.ClassName}" Classes="meta" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Classes="badge" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding NumberText}" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Spacing="10" IsVisible="{Binding HasAlts}">
                                        <Border Classes="rule" />
                                        <ItemsControl ItemsSource="{Binding Alts}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:CharacterRowViewModel">
                                                    <Grid ColumnDefinitions="40,*,Auto">
                                                        <Image Grid.Column="0" Width="26" Height="26" HorizontalAlignment="Center"
                                                               Margin="0,0,12,0"
                                                               Source="{Binding Character.ClassId, Converter={x:Static views:ClassIconConverter.Instance}}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13"
                                                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ClassName}" Classes="meta"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>

                        <!-- The outline tile that makes a new group; it takes the height of the row it ends up in. -->
                        <DataTemplate DataType="vm:AddGroupTileViewModel">
                            <Border Classes="addTile" MinHeight="70" Margin="0,0,14,14" Tapped="OnAddGroupTapped">
                                <TextBlock Text="+  새 그룹" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Right: the selected group's foldouts, shown only while a group is selected. -->
        <Border Grid.Column="1" Width="361" BorderThickness="1,0,0,0" BorderBrush="{StaticResource BorderBrushSoft}"
                Background="{StaticResource NavBrush}" IsVisible="{Binding HasSelection}">
            <ScrollViewer>
                <StackPanel Margin="16,18,16,24" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedGroupOrNull.Main.DisplayName}" Classes="pageTitle"
                                       VerticalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis" />
                            <Border Classes="badge">
                                <TextBlock Text="{Binding SelectedGroupOrNull.NumberText}" />
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Content="그룹 삭제" Classes="danger tight" Command="{Binding RemoveGroupCommand}" />
                        <Border Grid.Column="2" Classes="rowIcon" Margin="6,0,0,0" Tapped="OnClosePanelTapped">
                            <Viewbox Width="12" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M6,6 L18,18 M18,6 L6,18" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding SelectedGroupOrNull.Rows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Classes="addTile" Height="38" Tapped="OnAddAltTapped">
                        <TextBlock Text="+  부캐 추가" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
