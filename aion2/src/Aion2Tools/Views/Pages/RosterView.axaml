<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aion2Tools.ViewModels"
             xmlns:models="using:Aion2Tools.Models"
             xmlns:views="using:Aion2Tools.Views"
             x:Class="Aion2Tools.Views.Pages.RosterView"
             x:DataType="vm:RosterViewModel">

    <UserControl.Styles>
        <!-- The fold header is the whole hit target, as in a properties panel. -->
        <Style Selector="Border.foldHeader.toggle">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.foldHeader.toggle:pointerover">
            <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
        </Style>
        <Style Selector="Border.foldHeader.collapsed">
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Path.chevron">
            <Setter Property="Stroke" Value="{StaticResource TextDimBrush}" />
            <Setter Property="StrokeThickness" Value="3" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <!-- One character as a foldout: the header (chevron, kind, name) toggles the form under it. -->
        <DataTemplate DataType="vm:CharacterRowViewModel">
            <Border Classes="foldBox">
                <StackPanel>
                    <Border Classes="foldHeader toggle" Classes.collapsed="{Binding !IsExpanded}" Tapped="OnFoldTapped">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                            <Viewbox Grid.Column="0" Width="11" Height="11" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="chevron" Data="M9,5 l7,7 l-7,7" IsVisible="{Binding !IsExpanded}" />
                                    <Path Classes="chevron" Data="M5,9 l7,7 l7,-7" IsVisible="{Binding IsExpanded}" />
                                </Canvas>
                            </Viewbox>
                            <Border Grid.Column="1" Classes="badge" Classes.accent="{Binding Character.IsMain}">
                                <TextBlock Text="{Binding KindText}" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding DisplayName}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="3" Classes="rowIcon danger" Width="20" Height="20"
                                    IsVisible="{Binding !Character.IsMain}" Tapped="OnRemoveAltTapped">
                                <Viewbox Width="10" Height="10">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M6,6 L18,18 M18,6 L6,18" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Classes="foldBody" IsVisible="{Binding IsExpanded}">
                        <StackPanel Spacing="12">
                            <StackPanel>
                                <TextBlock Text="캐릭터 이름" Classes="fieldLabel" />
                                <TextBox Text="{Binding Character.Name}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="클래스" Classes="fieldLabel" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding $parent[UserControl].((vm:RosterViewModel)DataContext).Classes}"
                                          SelectedValueBinding="{Binding Id, DataType=models:ClassRecord}"
                                          SelectedValue="{Binding Character.ClassId, Converter={x:Static views:IgnoreNullConverter.Instance}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="models:ClassRecord">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Image Width="24" Height="24"
                                                       Source="{Binding Id, Converter={x:Static views:ClassIconConverter.Instance}}" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,10,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="전투력" Classes="fieldLabel" />
                                    <TextBox Text="{Binding CombatPowerText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="아이템 레벨" Classes="fieldLabel" />
                                    <TextBox Text="{Binding ItemLevelText}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid ColumnDefinitions="*,1,360">

        <!-- Left: the group cards. -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="24,20,24,0">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="캐릭터 명단" Classes="pageTitle" />
                    <TextBlock Text="{Binding CountText}" Classes="meta" />
                </StackPanel>
                <Button Grid.Column="1" Content="+  새 그룹" Classes="accent" Command="{Binding AddGroupCommand}"
                        IsEnabled="{Binding CanAddGroup}" VerticalAlignment="Center" />
            </Grid>

            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,0,0,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>
                        <!-- A group card: one line per character, icon / kind / name / class, all on the same columns. -->
                        <DataTemplate DataType="vm:PlayerGroupViewModel">
                            <Border Classes="card clickable" Classes.selected="{Binding IsSelected}"
                                    Width="300" MinHeight="150" Margin="0,0,14,14" Tapped="OnGroupTapped">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding Title}" Classes="cardTitle" />
                                    <Border Classes="rule" />
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:CharacterRowViewModel">
                                                <Grid ColumnDefinitions="40,46,*,Auto">
                                                    <Image Grid.Column="0" Width="32" Height="32" HorizontalAlignment="Left"
                                                           Source="{Binding Character.ClassId, Converter={x:Static views:ClassIconConverter.Instance}}" />
                                                    <Border Grid.Column="1" Classes="badge" Classes.accent="{Binding Character.IsMain}"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding KindText}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontSize="13"
                                                               Foreground="{StaticResource TextBrightBrush}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="3" Text="{Binding ClassName}" Classes="meta"
                                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>

                        <!-- The solid-outline tile with a plus that makes a new group. -->
                        <DataTemplate DataType="vm:AddGroupTileViewModel">
                            <Border Classes="addTile" Width="300" Height="150" Margin="0,0,14,14" Tapped="OnAddGroupTapped">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="+" FontSize="22" HorizontalAlignment="Center" />
                                    <TextBlock Text="새 그룹" FontSize="12" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BorderBrushSoft}" />

        <!-- Right: the selected group's foldouts, or the paste box when nothing is selected. -->
        <Border Grid.Column="2" Background="{StaticResource NavBrush}">
            <Panel>
                <ScrollViewer IsVisible="{Binding HasSelection}">
                    <StackPanel Margin="16,18,16,24" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
                            <TextBlock Text="{Binding SelectedGroupOrNull.Title, StringFormat='{}{0} 그룹'}" Classes="pageTitle"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="그룹 삭제" Classes="danger tight" Command="{Binding RemoveGroupCommand}" />
                            <Border Grid.Column="2" Classes="rowIcon" Margin="6,0,0,0" Tapped="OnClosePanelTapped">
                                <Viewbox Width="12" Height="12">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M6,6 L18,18 M18,6 L6,18" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding SelectedGroupOrNull.Rows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border Classes="addTile" Height="38" Tapped="OnAddAltTapped">
                            <TextBlock Text="+  부캐 추가" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Margin="16,18,16,24" Spacing="12" IsVisible="{Binding !HasSelection}">
                    <TextBlock Text="편집" Classes="pageTitle" />
                    <Border Classes="foldBox">
                        <StackPanel>
                            <Border Classes="foldHeader">
                                <TextBlock Text="표 / CSV 붙여넣기" />
                            </Border>
                            <Border Classes="foldBody">
                                <StackPanel Spacing="10">
                                    <TextBox Text="{Binding ImportText}" AcceptsReturn="True" Height="140"
                                             PlaceholderText="1, 철벽, 수호성, 36210, -, Y" />
                                    <Button Content="가져오기" Classes="accent" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" Command="{Binding ImportCommand}" />
                                    <TextBlock Text="{Binding StatusText}" Classes="meta" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Button Content="명단 비우기" Classes="danger tight" HorizontalAlignment="Left" Command="{Binding ClearCommand}" />
                </StackPanel>
            </Panel>
        </Border>
    </Grid>
</UserControl>
