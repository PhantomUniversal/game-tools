<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aion2Tools.ViewModels"
             xmlns:models="using:Aion2Tools.Models"
             xmlns:views="using:Aion2Tools.Views"
             x:Class="Aion2Tools.Views.Pages.RosterView"
             x:DataType="vm:RosterViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="캐릭터 명단" Classes="h1" Margin="0,0,0,12" />

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <Button Content="+ 추가" Classes="accent" Command="{Binding AddCommand}" Margin="0,0,8,6" />
            <Button Content="전체 참가" Command="{Binding SelectAllCommand}" Margin="0,0,8,6" />
            <Button Content="전체 해제" Command="{Binding SelectNoneCommand}" Margin="0,0,8,6" />
            <Button Content="비우기" Command="{Binding ClearCommand}" Margin="0,0,8,6" />
        </WrapPanel>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Classes="muted" Margin="0,0,0,8" />

        <Grid Grid.Row="3" ColumnDefinitions="50,130,150,140,110,100,60,50" Margin="4,0,0,4">
            <TextBlock Grid.Column="0" Text="참가" Classes="muted" />
            <TextBlock Grid.Column="1" Text="번호 (1~100)" Classes="muted" />
            <TextBlock Grid.Column="2" Text="캐릭터" Classes="muted" />
            <TextBlock Grid.Column="3" Text="클래스" Classes="muted" />
            <TextBlock Grid.Column="4" Text="전투력" Classes="muted" />
            <TextBlock Grid.Column="5" Text="아이템 Lv" Classes="muted" />
            <TextBlock Grid.Column="6" Text="본캐" Classes="muted" />
        </Grid>

        <ScrollViewer Grid.Row="4">
            <ItemsControl ItemsSource="{Binding Characters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:CharacterData">
                        <Grid ColumnDefinitions="50,130,150,140,110,100,60,50" Margin="4,2">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" />
                            <NumericUpDown Grid.Column="1" Value="{Binding Number, Converter={x:Static views:IgnoreNullConverter.Instance}}"
                                           Minimum="1" Maximum="100" FormatString="0" Margin="0,0,6,0" />
                            <TextBox Grid.Column="2" Text="{Binding Name}" Margin="0,0,6,0" />
                            <ComboBox Grid.Column="3" HorizontalAlignment="Stretch" Margin="0,0,6,0"
                                      ItemsSource="{Binding $parent[UserControl].((vm:RosterViewModel)DataContext).Classes}"
                                      SelectedValueBinding="{Binding Id, DataType=models:ClassRecord}"
                                      SelectedValue="{Binding ClassId, Converter={x:Static views:IgnoreNullConverter.Instance}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="models:ClassRecord">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Grid.Column="4" Text="{Binding CombatPower}" Margin="0,0,6,0" />
                            <TextBox Grid.Column="5" Text="{Binding ItemLevel}" Margin="0,0,6,0" />
                            <CheckBox Grid.Column="6" IsChecked="{Binding IsMain}" />
                            <Button Grid.Column="7" Content="✕"
                                    Command="{Binding $parent[UserControl].((vm:RosterViewModel)DataContext).RemoveCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Expander Grid.Row="5" Header="표 / CSV 붙여넣기" Margin="0,10,0,0" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="한 줄에 한 캐릭터: 번호(1~100), 캐릭터, 클래스(이름 또는 id), 전투력, 아이템 레벨, 본캐(Y/N). 쉼표나 탭(스프레드시트 복사) 모두 됩니다." />
                <TextBox Text="{Binding ImportText}" AcceptsReturn="True" Height="120"
                         PlaceholderText="1, 철벽, 수호성, 36210, 3820, Y" />
                <Button Content="가져오기" Classes="accent" Command="{Binding ImportCommand}" />
            </StackPanel>
        </Expander>
    </Grid>
</UserControl>
