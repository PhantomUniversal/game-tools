<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aion2Tools.ViewModels"
             x:Class="Aion2Tools.Views.Pages.PartyView"
             x:DataType="vm:PartyViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="파티 조합" Classes="h1" Margin="0,0,0,12" />

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <ContentControl Content="{Binding Preset}" Margin="0,0,12,6" />
            <Button Content="▶ 자동 조합" Classes="accent" Command="{Binding ComposeCommand}" Margin="0,0,8,6" />
            <Button Content="📋 텍스트 복사" Click="OnCopyClick" IsEnabled="{Binding HasResult}" Margin="0,0,0,6" />
        </WrapPanel>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Classes="muted" Margin="0,0,0,10" />

        <ListBox Grid.Row="3" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResultOrNull}"
                 Background="Transparent" Margin="0,0,0,10" IsVisible="{Binding HasResult}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:PartyResultViewModel">
                    <TextBlock Text="{Binding Title}" Margin="6,2" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer Grid.Row="4">
            <ContentControl Content="{Binding SelectedResultOrNull}" />
        </ScrollViewer>
    </Grid>
</UserControl>
