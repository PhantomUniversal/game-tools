<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aion2Tools.ViewModels"
             x:Class="Aion2Tools.Views.Pages.PartyView"
             x:DataType="vm:PartyViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24,20,24,0">
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,16">
            <TextBlock Text="파티 조합" Classes="pageTitle" />
            <TextBlock Text="{Binding StatusText}" Classes="meta" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,18">
            <ContentControl Content="{Binding Preset}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                <Button Content="텍스트 복사" Click="OnCopyClick" IsEnabled="{Binding HasResult}" />
                <Button Content="▶  자동 조합" Classes="accent" Command="{Binding ComposeCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" IsVisible="{Binding HasResult}" Margin="0,0,0,16">
            <ListBox Classes="tabs" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResultOrNull}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:PartyResultViewModel">
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Classes="rule" />
        </StackPanel>

        <ScrollViewer Grid.Row="3">
            <ContentControl Content="{Binding SelectedResultOrNull}" Margin="0,0,0,24" />
        </ScrollViewer>
    </Grid>
</UserControl>
