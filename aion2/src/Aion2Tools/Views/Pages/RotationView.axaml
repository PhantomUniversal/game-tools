<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aion2Tools.ViewModels"
             x:Class="Aion2Tools.Views.Pages.RotationView"
             x:DataType="vm:RotationViewModel">
    <Grid RowDefinitions="Auto,Auto,*" Margin="24,20,24,0">
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,16">
            <TextBlock Text="본부 조합 · 본캐 / 부캐 로테이션" Classes="pageTitle" />
            <TextBlock Text="{Binding StatusText}" Classes="meta" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,16,Auto,16,Auto,*,Auto" Margin="0,0,0,18">
            <ContentControl Grid.Column="0" Content="{Binding Preset}" />
            <StackPanel Grid.Column="2">
                <TextBlock Text="회차" Classes="fieldLabel" />
                <NumericUpDown Value="{Binding RunCount}" Minimum="1" Maximum="10" FormatString="0" Width="110" />
            </StackPanel>
            <CheckBox Grid.Column="4" Content="본캐 1회차 몰아주기" IsChecked="{Binding IsMainFirst}" VerticalAlignment="Bottom"
                      Margin="0,0,0,6" />
            <Button Grid.Column="6" Content="▶  로테이션 생성" Classes="accent" Command="{Binding ComposeCommand}"
                    VerticalAlignment="Bottom" />
        </Grid>

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="22" Margin="0,0,0,24">
                <Border Classes="card" HorizontalAlignment="Left">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="번호" Width="70" Classes="meta" />
                            <TextBlock Text="캐릭터 (★ 본캐)" Width="300" Classes="meta" />
                            <ItemsControl ItemsSource="{Binding RunHeaders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" Width="170" Classes="meta" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Border Classes="rule" />
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:RotationRowViewModel">
                                    <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="0,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Number}" Width="70" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrightBrush}" />
                                            <TextBlock Text="{Binding Characters}" Width="300" TextWrapping="Wrap" Classes="meta"
                                                       Margin="0,0,10,0" />
                                            <ItemsControl ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding}" Width="170" FontSize="13"
                                                                   Foreground="{StaticResource TextLightBrush}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Runs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="22" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PartyResultViewModel">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Title}" Classes="pageTitle" />
                                <ContentControl Content="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
