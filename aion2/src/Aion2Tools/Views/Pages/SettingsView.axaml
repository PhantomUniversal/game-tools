<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aion2Tools.ViewModels"
             x:Class="Aion2Tools.Views.Pages.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left" Margin="24,20,24,24">
            <TextBlock Text="설정" Classes="pageTitle" Margin="0,0,0,4" />

            <Border Classes="foldBox">
                <StackPanel>
                    <Border Classes="foldHeader">
                        <TextBlock Text="앱 업데이트" />
                    </Border>
                    <Border Classes="foldBody">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding Update.VersionText, StringFormat='버전  {0}'}" FontSize="13"
                                       Foreground="{StaticResource TextBrightBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="지금 업데이트" Classes="accent" Command="{Binding Update.StartCommand}"
                                        IsVisible="{Binding Update.CanStart}" />
                                <Button Content="재시작" Command="{Binding Update.RestartCommand}" IsVisible="{Binding Update.IsReady}" />
                            </StackPanel>
                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding Update.IsBuilding}" />
                            <TextBlock Text="{Binding Update.StatusText}" FontSize="13" />
                            <TextBlock Text="{Binding Update.LastLine}" Classes="hint" FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="foldBox">
                <StackPanel>
                    <Border Classes="foldHeader">
                        <TextBlock Text="게임 데이터" />
                    </Border>
                    <Border Classes="foldBody">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding DataVersionText, StringFormat='사용 중  {0}'}" FontSize="13"
                                       Foreground="{StaticResource TextBrightBrush}" />
                            <StackPanel>
                                <TextBlock Text="데이터 주소" Classes="fieldLabel" />
                                <TextBox Text="{Binding GameDataUrl}" />
                            </StackPanel>
                            <CheckBox Content="시작할 때 자동 확인" IsChecked="{Binding IsAutoCheckOn}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="지금 확인" Classes="accent" Command="{Binding CheckDataCommand}" />
                                <TextBlock Text="{Binding DataStatusText}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextLightBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="foldBox">
                <StackPanel>
                    <Border Classes="foldHeader">
                        <TextBlock Text="저장 위치" />
                    </Border>
                    <Border Classes="foldBody">
                        <TextBlock Text="{Binding SettingsFolder}" Classes="hint" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
