<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aion2Tools.ViewModels"
        x:Class="Aion2Tools.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="AION2 파티 · 본부 조합"
        Width="1320" Height="860"
        Background="{StaticResource WindowBrush}"
        FontFamily="Malgun Gothic,Inter">

    <Panel>
        <Grid ColumnDefinitions="210,*">
            <Border Grid.Column="0" Background="{StaticResource NavBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto" Margin="10,16">
                    <TextBlock Grid.Row="0" Text="⚔ AION2 Tools" Classes="h2" Margin="8,0,0,16" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:NavItemViewModel">
                                <TextBlock Text="{Binding Title}" FontSize="14" Margin="2,4" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="{Binding Update.VersionText}" Classes="muted" FontSize="11"
                               TextWrapping="Wrap" Margin="8,0" />
                </Grid>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding SelectedNav.Page}" Margin="24,20" />
        </Grid>

        <!-- The update notice, opened by the check at start. -->
        <Border Classes="card" IsVisible="{Binding Update.IsNoticeOpen}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" Width="340"
                BorderBrush="{StaticResource AccentBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="🔔 앱 업데이트" Classes="h2" />
                <TextBlock Text="{Binding Update.StatusText}" TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding Update.IsBuilding}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="지금 업데이트" Classes="accent" Command="{Binding Update.StartCommand}"
                            IsVisible="{Binding Update.CanStart}" />
                    <Button Content="재시작" Classes="accent" Command="{Binding Update.RestartCommand}"
                            IsVisible="{Binding Update.IsReady}" />
                    <Button Content="닫기" Command="{Binding Update.CloseNoticeCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Panel>
</Window>
