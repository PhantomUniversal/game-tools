<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aion2Tools.ViewModels"
        x:Class="Aion2Tools.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title=""
        Width="1360" Height="860"
        Background="{StaticResource WindowBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32"
        FontFamily="Malgun Gothic,Inter">

    <Window.DataTemplates>
        <!-- One sidebar row: a stroke icon and the page name, the selected one on a filled band. -->
        <DataTemplate DataType="vm:NavItemViewModel">
            <Border Classes="navRow" Classes.active="{Binding IsActive}" Tapped="OnNavTapped" Margin="0,1">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,8">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Path Classes="icon" Data="{Binding IconData}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextLightBrush}" FontSize="13"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Panel>
        <!-- The strip the window is dragged by; the system draws its buttons on the right. -->
        <Border Height="32" VerticalAlignment="Top" Background="Transparent" PointerPressed="OnTitleBarPointerPressed" />

        <Grid ColumnDefinitions="240,1,*" Margin="0,32,0,0">
            <Border Grid.Column="0" Background="{StaticResource NavBrush}" />
            <Grid Grid.Column="0" Margin="12,12,12,16" RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="12,0,0,14">
                    <Image Width="22" Height="22" Source="/Assets/Classes/gladiator.png" />
                    <TextBlock Text="Daeva" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrightBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding NavItems}" />
                <ContentControl Grid.Row="2" Content="{Binding SettingsNav}" />
            </Grid>

            <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BorderBrushSoft}" />

            <Grid Grid.Column="2" RowDefinitions="48,*">
                <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrushSoft}">
                    <StackPanel Orientation="Horizontal" Margin="24,0" VerticalAlignment="Center">
                        <TextBlock Classes="crumb" Text="Daeva" />
                        <TextBlock Classes="crumbSep" Text="&#x203A;" />
                        <TextBlock Classes="crumbCurrent" Text="{Binding SelectedNav.Title}" />
                    </StackPanel>
                </Border>
                <ContentControl Grid.Row="1" Content="{Binding SelectedNav.Page}" />
            </Grid>
        </Grid>

        <!-- The update notice, opened by the check at start. -->
        <Border Classes="card" IsVisible="{Binding Update.IsNoticeOpen}" BoxShadow="0 10 30 0 #A0000000"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" Width="340"
                BorderBrush="{StaticResource AccentBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="앱 업데이트" Classes="cardTitle" />
                <TextBlock Text="{Binding Update.StatusText}" TextWrapping="Wrap" FontSize="13" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding Update.IsBuilding}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="지금 업데이트" Classes="accent" Command="{Binding Update.StartCommand}"
                            IsVisible="{Binding Update.CanStart}" />
                    <Button Content="재시작" Classes="accent" Command="{Binding Update.RestartCommand}"
                            IsVisible="{Binding Update.IsReady}" />
                    <Button Content="닫기" Command="{Binding Update.CloseNoticeCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Panel>
</Window>
