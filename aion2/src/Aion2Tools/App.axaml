<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aion2Tools.ViewModels"
             xmlns:pages="using:Aion2Tools.Views.Pages"
             xmlns:models="using:Aion2Tools.Models"
             xmlns:views="using:Aion2Tools.Views"
             x:Class="Aion2Tools.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Aion2Tools/Styles/Theme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- Fluent's own accent (progress bars, list and combo highlights) in the same gold. -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#C9A45C" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <!-- After the theme: most of these rules undo a Fluent default. -->
        <StyleInclude Source="avares://Aion2Tools/Styles/AppStyles.axaml" />
    </Application.Styles>

    <Application.DataTemplates>
        <DataTemplate DataType="vm:PartyViewModel">
            <pages:PartyView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProfilesViewModel">
            <pages:ProfilesView />
        </DataTemplate>
        <DataTemplate DataType="vm:RosterViewModel">
            <pages:RosterView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <pages:SettingsView />
        </DataTemplate>

        <!-- The preset box and its cuts on the party page. -->
        <DataTemplate DataType="vm:PresetPickerViewModel">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel>
                    <TextBlock Text="콘텐츠" Classes="fieldLabel" />
                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPresetOrNull}" MinWidth="230">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="models:PresetRecord">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="아이템 레벨 이상" Classes="fieldLabel" />
                    <NumericUpDown Value="{Binding MinItemLevel, Converter={x:Static views:IgnoreNullConverter.Instance}}"
                                   Minimum="0" Increment="100" FormatString="0" Width="140" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="전투력 이상" Classes="fieldLabel" />
                    <NumericUpDown Value="{Binding MinCombatPower, Converter={x:Static views:IgnoreNullConverter.Instance}}"
                                   Minimum="0" Increment="1000" FormatString="0" Width="150" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- One composition: party cards, rule checks, bench. -->
        <DataTemplate DataType="vm:PartyResultViewModel">
            <StackPanel Spacing="14">
                <ItemsControl ItemsSource="{Binding Parties}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PartyCardViewModel">
                            <Border Classes="card" Width="340" Margin="0,0,14,14">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Title}" Classes="cardTitle" />
                                        <TextBlock Grid.Column="1" Text="{Binding Summary}" Classes="meta" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Classes="rule" />
                                    <ItemsControl ItemsSource="{Binding Members}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:MemberRowViewModel">
                                                <Grid ColumnDefinitions="40,*,Auto,Auto">
                                                    <Image Width="34" Height="34" HorizontalAlignment="Left"
                                                           Source="{Binding ClassId, Converter={x:Static views:ClassIconConverter.Instance}}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextBrightBrush}" />
                                                        <TextBlock Text="{Binding Detail}" Classes="meta" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding CombatPowerText}" FontSize="13"
                                                               Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <Border Grid.Column="3" Background="{Binding RoleBrush}" CornerRadius="3" Padding="6,1"
                                                            VerticalAlignment="Center" MinWidth="34">
                                                        <TextBlock Text="{Binding RoleText}" Foreground="#10141D" FontSize="11"
                                                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="foldBox" MaxWidth="694" HorizontalAlignment="Left">
                    <StackPanel>
                        <Border Classes="foldHeader">
                            <TextBlock Text="규칙 확인" />
                        </Border>
                        <Border Classes="foldBody">
                            <ItemsControl ItemsSource="{Binding Checks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" Margin="0,3" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextLightBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Classes="foldBox" MaxWidth="694" HorizontalAlignment="Left" IsVisible="{Binding HasBench}">
                    <StackPanel>
                        <Border Classes="foldHeader">
                            <TextBlock Text="대기 · 제외" />
                        </Border>
                        <Border Classes="foldBody">
                            <ItemsControl ItemsSource="{Binding Bench}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" Classes="meta" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Application.DataTemplates>
</Application>
